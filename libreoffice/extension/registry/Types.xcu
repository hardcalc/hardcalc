<?xml version="1.0" encoding="UTF-8"?>
<!-- File type: *.hcmd (the first extension is the one Save As writes) and
     Markdown with hardcalc tables.
     URLPattern: LibreOffice takes a type matched by pattern at once, before
     all types matched only by extension and without asking a detection
     service - so *.hcmd never ends up in Writer. For other .md
     files the detection service decides; without hardcalc content they
     still go to Writer. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:package="org.openoffice.TypeDetection" oor:name="Types">
  <node oor:name="Types">
    <node oor:name="hardcalc_Markdown" oor:op="replace">
      <prop oor:name="DetectService"><value>org.hardcalc.libreoffice.calc.MarkdownDetect</value></prop>
      <prop oor:name="URLPattern"><value>*.hcmd *.HCMD</value></prop>
      <prop oor:name="Extensions"><value>hcmd md</value></prop>
      <prop oor:name="MediaType"><value>text/markdown</value></prop>
      <prop oor:name="Preferred"><value>true</value></prop>
      <prop oor:name="PreferredFilter"><value>hardcalc Markdown</value></prop>
      <prop oor:name="UIName"><value xml:lang="en-US">hardcalc Markdown (.hcmd)</value></prop>
      <prop oor:name="ClipboardFormat"/>
    </node>
  </node>
</oor:component-data>
